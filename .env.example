# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Used by the seed script and the RLS tests. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL used in auth emails (magic link redirect)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paid layer is a stub in v1. Leave false.
PAID_TOOLS_ENABLED=false
# Enquiries in the last 30 days before a club sees the upgrade prompt.
UPGRADE_ENQUIRY_THRESHOLD=10
# Show the "Demo data" banner.
NEXT_PUBLIC_DEMO_DATA=true

# Password for the seeded demo accounts (parent, club owner, admin). Pick your own.
DEMO_ACCOUNT_PASSWORD=change-me-locally
